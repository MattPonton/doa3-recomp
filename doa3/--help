    if(!doa3_loop_valid(s) || !doa3_input_tape_replay_ready(t) ||
       (s->pending!=0xA65B0 && s->pending!=0xA6680))return 0;
    size_t bytes=xbox_GetMemorySize();uint32_t sp=g_esp,routine=s->pending;
